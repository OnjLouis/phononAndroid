+/// Load a validated local file into the Android front end's reusable voice slot.
+///
+/// # Safety
+/// The handle must be exclusively borrowed and path must be NUL-terminated UTF-8.
+#[cfg(target_os = "android")]
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn phonon_register_imported_voice(
+    h: *mut PttsHandle,
+    path: *const c_char,
+) -> bool {
+    let h = unsafe { &mut *h };
+    let path = unsafe { CStr::from_ptr(path) }.to_string_lossy();
+    match guarded(|| h.engine.register_imported_voice(Path::new(path.as_ref()))) {
+        Ok(()) => {
+            h.voice_blob = nul_separated(h.engine.voices());
+            true
+        }
+        Err(e) => {
+            h.last_error = Some(c_string(&e));
+            false
+        }
+    }
+}
