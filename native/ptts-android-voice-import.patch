+    pub fn register_imported_voice(&mut self, path: &Path) -> Result<(), String> {
+        // Keep only one imported embedding and its primed state in memory.
+        const SLOT: &str = "_phonon_import";
+        self.synth.add_voice_file(SLOT, path).map_err(|error| error.to_string())?;
+        if !self.voices.iter().any(|name| name == SLOT) {
+            self.voices.push(SLOT.to_string());
+            self.voices.sort();
+        }
+        Ok(())
+    }
